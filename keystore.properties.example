# Copy this file to `keystore.properties` (git-ignored) and fill in real values to
# produce a signed release build locally. Never commit `keystore.properties`,
# `*.jks`, `*.p12`, or passwords. Placeholders only in this example.
#
# Full instructions: docs/RELEASE_AAB.md
# Play listing / Data Safety notes: docs/PLAY_STORE.md
# Privacy policy draft: docs/PRIVACY.md
#
#   ./gradlew :app:checkReleaseScaffold
#   ./gradlew :app:printReleaseSigningStatus
#   ./gradlew :app:assembleRelease   # signed APK
#   ./gradlew :app:bundleRelease     # signed AAB for Google Play
#   ./scripts/smoke-signed-aab.sh    # throwaway keystore; do not upload to Play
#
# In CI, provide the same values as environment variables instead of this file
# (env vars override this file):
#   KEYSTORE_FILE, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD
# (see .github/workflows/release.yml, which decodes a base64 keystore secret).
#
# To generate an upload keystore:
#   keytool -genkeypair -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 \
#     -validity 10000 -alias upload

storeFile=upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME

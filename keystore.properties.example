# Copy this file to `keystore.properties` (git-ignored) and fill in real values to
# produce a signed release build locally:
#
#   ./gradlew :app:assembleRelease   # signed APK
#   ./gradlew :app:bundleRelease     # signed AAB for Google Play
#
# In CI, provide the same values as environment variables instead of this file:
#   KEYSTORE_FILE, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD
# (see .github/workflows/release.yml, which decodes a base64 keystore secret).
#
# To generate an upload keystore:
#   keytool -genkeypair -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 \
#     -validity 10000 -alias upload

storeFile=upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME

<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ cloud backup and device-to-device transfer. Vault data stays on-device
  unless the user uses NullKey's explicit Export / Secure Backup flows.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="vault/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="vault/" />
    </device-transfer>
</data-extraction-rules>
